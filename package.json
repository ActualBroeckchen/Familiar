{
  "name": "proto-familiar",
  "version": "0.11.19-alpha",
  "description": "Lightweight LLM frontend for z.ai, NanoGPT, and Google AI Studio",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ScarletPrinceEury/Proto-Familiar",
    "branch": "main"
  },
  "scripts": {
    "prestart": "node scripts/ensure-node-deps.mjs && node scripts/ensure-phylactery-deps.mjs && node scripts/ensure-unruh-deps.mjs && node scripts/ensure-port-free.mjs",
    "start": "node server.js",
    "predev": "node scripts/ensure-node-deps.mjs && node scripts/ensure-phylactery-deps.mjs && node scripts/ensure-unruh-deps.mjs && node scripts/ensure-port-free.mjs",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.mjs",
    "import-entity": "node scripts/import-entity.js",
    "import-tome": "node scripts/import-tome.js",
    "pin:listening": "node scripts/pin-audio-models.mjs asr-offline --upstream",
    "audit:wiring": "node scripts/audit-wiring.mjs",
    "audit:mcp": "node scripts/audit-mcp-contracts.mjs"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.5.0",
    "@noble/ciphers": "^1.3.0",
    "express": "^4.18.2",
    "libsodium-wrappers": "^0.7.16",
    "linkedom": "^0.18.12",
    "opusscript": "^0.1.1",
    "tar": "^7.5.22",
    "turndown": "^7.2.4",
    "unbzip2-stream": "^1.4.3",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "optionalDependencies": {
    "playwright-core": "^1.62.1",
    "sherpa-onnx-node": "^1.13.4"
  }
}
