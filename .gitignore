.proto-familiar.log.err
.pf-install-complete
.pf-node-deps.json
settings.json
settings.json.tmp
packagebackup.json
# Per-install runtime data directories (never committed).
data/
lorebook/
memory/
# Windows shell metadata.
desktop.ini
**/desktop.ini
# Village registry local mirror (V1) — canonical copy lives in Phylactery.
village.json
village.json.tmp
.pf-backups/
# Claude Code agent worktree metadata (generated by the Agent tool).
.claude/
# CodeAlmanac local runtime state (job logs, index cache) — the wiki pages
# under almanac/ are tracked; only ephemeral CLI-generated artifacts are not.
almanac/.codealmanac/
almanac/*.db
almanac/*.db-journal

# Audio models — machine artifacts, fetched on demand, never committed (voice spec §0.1)
models/

# Reference voice clips (voice spec §6.5).
#
# voices/bundled/ IS committed — one clip, ~1.2 MB, the voice I have before my
# human has an opinion. It is in the repo rather than fetched so that a voice
# cannot go missing on a machine with no connection.
#
# The two below are not:
#   installed/  reproducible from a pinned url + checksum, so committing them
#               would mean every clone paying ~8 MB for choices almost nobody
#               makes.
#   ward/       clips my human gave me. This line is a privacy guard, not
#               housekeeping — such a clip may be someone else's copyrighted
#               performance, and personal use is theirs to make while
#               redistribution is not. It must never reach a commit.
voices/installed/
voices/ward/

# Temperature-probe renders — audition material, re-derivable by running the
# probe again, and pointless to carry in the repo.
voice-probe/

# Pin-time scratch (measuring what an archive unpacks to) — never committed
.pin-measure/

# Runtime state written by the running server (siblings of the tomes/.*.json above)
tomes/.memory-coverage.json
tomes/.memory-coverage.json.tmp
tomes/.stewardship-state.json
tomes/.stewardship-state.json.tmp

# Measured pitch of previewed reference clips — a cache, re-derivable by listening again
tomes/.voice-clip-features.json
tomes/.voice-clip-features.json.tmp

# Python bytecode — machine artifacts from any of the Python peers.
__pycache__/
*.pyc

# voicebox — Python venv and torch are machine artifacts, never committed
voicebox/.venv/
voicebox/uv.lock

# Session transcripts — generated from a Claude Code session log by
# `scripts/transcript-to-markdown.mjs`, for codealmanac to ingest locally.
# Not committed: they are megabytes of raw conversation that regenerate from
# the source log, and the durable version of what they contain belongs in the
# almanac and in docs/ rather than in a wall of chat.
docs/voice-development-transcript.md
docs/*-transcript.md
