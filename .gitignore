tomes/.vision-capability.json
tomes/.vision-capability.json.tmp
tomes/.memorization-queue.json
tomes/.memorization-queue.json.tmp
# Threat-tracker state (step 4b) — local, decaying scalar; never committed.
tomes/.threat-state.json
tomes/.threat-state.json.tmp
# Wait-streak experiment state (initiative-build-spec Pass 1) — local counter.
tomes/.wait-streak.json
tomes/.wait-streak.json.tmp
# Contact-baselines cache (initiative-build-spec Pass 2) — derived, local.
tomes/.contact-baselines.json
tomes/.contact-baselines.json.tmp
# Generated SearXNG config (random secret, per-boot port) — never committed.
tomes/.searxng/
# Outbox delivery queue (M11) — local pending notifications.
tomes/.outbox.json
tomes/.outbox.json.tmp
# Silence-triage last-activity stamp (M12b).
tomes/.last-activity.json
tomes/.last-activity.json.tmp
# Surface-events stream (slice 2) — per-embodiment record of offers + outcomes.
tomes/.surface-events.json
tomes/.surface-events.json.tmp
# Discord gateway runtime state — conversation map, rate-limit buckets, revisit queue.
tomes/.discord-map.json
tomes/.discord-map.json.tmp
tomes/.discord-revisits.json
tomes/.discord-revisits.json.tmp
tomes/.rate-limits.json
tomes/.rate-limits.json.tmp
# Google Calendar projection-cue aging state (§4).
tomes/.gcal-projection-cue.json
tomes/.gcal-projection-cue.json.tmp
# Google OAuth token store (refresh/access tokens — NEVER commit).
tomes/.gcal-google-token.json
tomes/.gcal-google-token.json.tmp
# Consent-pending tracking for the memorization greenlight flow.
tomes/.consent-pending.json
tomes/.consent-pending.json.tmp
# Village knock tracking — contact attempts from unregistered users/locations.
tomes/.village-knocks.json
tomes/.village-knocks.json.tmp
tomes/.village-location-knocks.json
tomes/.village-location-knocks.json.tmp
# User-generated tomes (Session Memories, Familiar's Ponderings, etc.)
